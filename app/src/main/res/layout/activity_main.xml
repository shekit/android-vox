<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="24dp">

    <!-- MCP mode (default) -->

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_mcp"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonRemoteControl"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/button_start_server"
        android:textSize="16sp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#888888"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/buttonRemoteControl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonLocalMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_switch_local"
        android:textSize="12sp"
        style="?android:attr/borderlessButtonStyle"
        android:textColor="#888888"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Local mode (hidden by default) -->

    <LinearLayout
        android:id="@+id/localModeSection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/buttonLocalMode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editApiKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_api_key"
                android:textColor="@android:color/white"
                android:textColorHint="#888888"
                android:backgroundTint="@android:color/white"
                android:inputType="textPassword"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonSaveApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_save_api_key" />

        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/btn_dropdown"
            android:popupBackground="#333333" />

        <EditText
            android:id="@+id/editCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_command"
            android:textColor="@android:color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@android:color/white"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/buttonAskClaude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_ask_claude"
            android:layout_marginTop="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/textResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="monospace" />

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
